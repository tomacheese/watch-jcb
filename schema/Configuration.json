{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
        "discord": {
            "description": "Discord の Webhook URL または Bot トークン",
            "properties": {
                "channel_id": {
                    "description": "Discord のチャンネル ID (Bot を使う場合は必須)",
                    "type": "string"
                },
                "token": {
                    "description": "Discord の Bot トークン (Bot を使う場合は必須)",
                    "type": "string"
                },
                "webhook_url": {
                    "description": "Discord の Webhook URL (Webhook を使う場合は必須)",
                    "type": "string"
                }
            },
            "type": "object"
        }
    },
    "required": [
        "discord"
    ],
    "type": "object"
}

